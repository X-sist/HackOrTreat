    {
      "id": "line-overflow",
      "role": "tx",
      "line": "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX\n",
      "expected": "LINE_TOO_LONG"
    },
    {
      "id": "odd-hex",
      "role": "tx",
      "line": "SEND\t12345678\t0001\t486\n",
      "expected": "MALFORMED_COMMAND"
    },
    {
      "id": "send-to-receiver",
      "role": "rx",
      "line": "SEND\t12345678\t0001\t4869\n",
      "expected": "UNKNOWN_COMMAND"
    },
    {
      "id": "split-and-multiple",
      "role": "tx",
      "chunks": [
        "SEND\t1234",
        "5678\t0001\t48",
        "69\nHELLO\n"
      ],
      "expected_lines": [
        "SEND\t12345678\t0001\t4869",
        "HELLO"
      ],
      "note": "Line framing only. Hosts must not pipeline HELLO while SEND is busy."
    },
    {
      "id": "recover-after-overflow",
      "role": "tx",
      "chunks": [
        "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX",
        "\nHELLO\n"
      ],
      "expected": "LINE_TOO_LONG_THEN_HELLO",
      "note": "Discard the whole overflowing line before processing HELLO."
    }
  ]
